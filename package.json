{
  "name": "pes2017-nextgen-manager",
  "version": "0.1.0",
  "private": true,
  "description": "THEGODMODS PES 2017 Next Gen Graphics Manager",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "predev": "tsc -p electron && node tools/copy-electron-assets.mjs",
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "npm run mods:build-original && npm run mods:build-packs && npm run mods:verify-packs && tsc --noEmit && vite build && tsc -p electron/tsconfig.json && node tools/copy-electron-assets.mjs",
    "dist:win": "npm run build && electron-builder --win nsis",
    "typecheck": "tsc --noEmit --pretty && tsc -p electron/tsconfig.json --noEmit",
    "clean": "rimraf dist dist-electron release",
    "test": "vitest run",
    "audit:dds": "node tools/dds-audit.mjs",
    "inventory:pitch": "node tools/pitch-inventory.mjs",
    "build:pitch-module": "node tools/pitch-module-builder.mjs",
    "inspect:dds": "node tools/dds-inspect.mjs",
    "compare:dds": "node tools/dds-compare.mjs",
    "preview:dds": "node tools/dds-preview.mjs",
    "sign:package": "node tools/sign-package-release.mjs",
    "mods:build-original": "node tools/build-original-mods.mjs",
    "mods:build-packs": "node tools/build-pes2017-modules.mjs",
    "mods:verify-packs": "node tools/verify-built-modules.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1",
    "vitest": "^2.1.8"
  },
  "build": {
    "appId": "com.thegodmods.pes2017nextgen",
    "productName": "THEGODMODS PES 2017 Next Gen Graphics Manager",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "tools/**/*",
      "content/originals/generated/**/*",
      "content/packs/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "THEGODMODS PES 2017 Next Gen Manager",
      "uninstallDisplayName": "THEGODMODS PES 2017 Next Gen Graphics Manager",
      "installerLanguages": [
        "en_US"
      ]
    },
    "artifactName": "THEGODMODS-PES2017-NextGen-Manager-${version}-Setup.${ext}"
  }
}
