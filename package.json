{
  "name": "godmods-manager",
  "version": "0.2.0",
  "private": true,
  "description": "GODMODS Manager — premium PES 2017 mod management",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "predev": "tsc -p electron && node tools/copy-electron-assets.mjs",
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "npm run mods:build-original && npm run mods:build-packs && npm run mods:verify-packs && tsc --noEmit && vite build && tsc -p electron/tsconfig.json && node tools/copy-electron-assets.mjs",
    "dist:win": "npm run build && electron-builder --win nsis",
    "typecheck": "tsc --noEmit --pretty && tsc -p electron/tsconfig.json --noEmit",
    "clean": "rimraf dist dist-electron release",
    "test": "vitest run",
    "audit:dds": "node tools/dds-audit.mjs",
    "audit:pes2017-resources": "node tools/pes2017-resource-audit.mjs scan",
    "compose:godmods-texture": "node tools/godmods-dds-compositor.mjs",
    "validate:pes2017-mapping": "node tools/pes2017-resource-audit.mjs validate",
    "audit:godmods-audio": "node tools/godmods-audio-qa.mjs",
    "audit:godmods-gameplay": "node tools/godmods-gameplay-qa.mjs",
    "audit:godmods-luts": "node tools/godmods-lut-qa.mjs",
    "audit:godmods-final": "node tools/godmods-final-regression.mjs",
    "inventory:pitch": "node tools/pitch-inventory.mjs",
    "build:pitch-module": "node tools/pitch-module-builder.mjs",
    "inspect:dds": "node tools/dds-inspect.mjs",
    "compare:dds": "node tools/dds-compare.mjs",
    "preview:dds": "node tools/dds-preview.mjs",
    "sign:package": "node tools/sign-package-release.mjs",
    "mods:build-original": "node tools/build-original-mods.mjs && node tools/build-god-turf-stadiumserver.mjs && npm run audit:god-turf && npm run mods:build-kits && npm run mods:build-faces && npm run mods:build-visuals && npm run mods:build-stadiums && npm run mods:build-atmosphere && npm run mods:build-gameplay && npm run mods:build-cinematic && npm run mods:build-natural",
    "mods:build-packs": "node tools/build-pes2017-modules.mjs",
    "mods:verify-packs": "node tools/verify-built-modules.mjs",
    "mods:check-lua": "node tools/check-lua-syntax.mjs",
    "mods:build-kits": "node tools/build-god-kits-material-lab.mjs",
    "mods:build-faces": "node tools/build-god-faces-premium-lab.mjs",
    "mods:build-visuals": "node tools/build-god-visuals-elite-suite.mjs",
    "mods:build-stadiums": "node tools/build-god-stadiums-elite.mjs",
    "mods:build-atmosphere": "node tools/build-god-atmosphere-premium.mjs",
    "mods:build-gameplay": "node tools/build-god-gameplay-premium.mjs",
    "mods:build-cinematic": "node tools/build-god-cinematic-premium.mjs",
    "mods:build-natural": "node tools/build-god-natural-premium.mjs",
    "audit:god-turf": "node tools/god-turf-qa.mjs",
    "inventory:stadium-resources": "node tools/stadium-resource-inventory.mjs",
    "validate:god-kits-mapping": "node tools/god-kits-mapping.mjs",
    "validate:god-faces-mapping": "node tools/god-faces-mapping.mjs",
    "validate:godmods-integration": "node tools/godmods-integration-gate.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1",
    "vitest": "^2.1.8"
  },
  "build": {
    "appId": "com.thegodmods.pes2017nextgen",
    "productName": "GODMODS Manager",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "tools/**/*",
      "content/originals/generated/**/*",
      "content/packs/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GODMODS Manager",
      "uninstallDisplayName": "GODMODS Manager",
      "installerLanguages": [
        "en_US"
      ]
    },
    "artifactName": "GODMODS-Manager-${version}-Setup.${ext}",
    "asarUnpack": [
      "dist-electron/electron/dds-worker.cjs"
    ]
  }
}
